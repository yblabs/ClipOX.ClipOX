# ---------------------------------------------------------------------------
# Framewright admin server — COPY THIS FILE TO `.env` AND FILL IN THE VALUES.
#   cp .env.example .env
# `.env` is git-ignored. Never put these values in HTML, CSS or client JS.
# ---------------------------------------------------------------------------

# Admin login. This is an ID, not an email — the login form accepts any
# non-empty string here and applies NO email validation to it.
ADMIN_LOGIN=your-admin-id

# Admin password. Use a long, unique passphrase.
ADMIN_PASSWORD=change-me

# Long random string used to sign the session JWT (openssl rand -hex 48)
JWT_SECRET=replace-with-64-plus-random-hex-characters

# --- HTTP ------------------------------------------------------------------
# Port this server listens on (it also serves the static site).
PORT=4000

# Where the existing FastAPI app runs. The Node server proxies /api, /media
# and /fonts to it so everything lives on ONE origin (cookies then work).
UPSTREAM=http://127.0.0.1:8000

# Origins allowed by CORS and by the CSRF origin check (comma separated).
SITE_ORIGINS=http://127.0.0.1:4000,http://localhost:4000,http://127.0.0.1:8000,http://localhost:8000

# Set to true when serving over HTTPS (adds the Secure flag to the cookie).
COOKIE_SECURE=false

# development | production
NODE_ENV=development
